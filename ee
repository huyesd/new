				local KeybindButton = Instance.new("TextButton")
				KeybindButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
				KeybindButton.BorderSizePixel = 0
				KeybindButton.Position = UDim2.new(0.62, 0, 0.1, 0)
				KeybindButton.Size = UDim2.new(0.37, 0, 0.8, 0)
				KeybindButton.Font = Enum.Font.Code
				KeybindButton.Text = "[" .. default .. "]"
				KeybindButton.TextColor3 = Color3.fromRGB(200, 200, 200)
				KeybindButton.TextSize = 11
				KeybindButton.Parent = KeybindContainer
				
				local KeybindCorner = Instance.new("UICorner")
				KeybindCorner.CornerRadius = UDim.new(0.2, 0)
				KeybindCorner.Parent = KeybindButton
				
				local KeybindStroke = Instance.new("UIStroke")
				KeybindStroke.Color = Color3.fromRGB(40, 40, 40)
				KeybindStroke.Thickness = 1
				KeybindStroke.Parent = KeybindButton
				
				local currentKey = default
				local listening = false
				
				KeybindButton.MouseButton1Click:Connect(function()
					if listening then return end
					listening = true
					KeybindButton.Text = "[...]"
					
					local connection
					connection = UserInputService.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.Keyboard then
							local keyName = input.KeyCode.Name
							currentKey = keyName
							KeybindButton.Text = "[" .. keyName .. "]"
							callback(keyName)
							listening = false
							connection:Disconnect()
						end
					end)
				end)
				
				KeybindButton.MouseEnter:Connect(function()
					Tween(KeybindButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)})
				end)
				
				KeybindButton.MouseLeave:Connect(function()
					Tween(KeybindButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)})
				end)
				
				return {
					SetKey = function(self, key)
						currentKey = key
						KeybindButton.Text = "[" .. key .. "]"
					end,
					GetKey = function(self)
						return currentKey
