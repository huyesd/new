--// Roblox UI Library
--// Version 1.0.1
--// Reference-accurate scaling & layout

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Library = {}
Library.__index = Library

--// Tween helper
local function Tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

--// Create Library
function Library.new()
	local self = setmetatable({}, Library)

	self.ScreenGui = Instance.new("ScreenGui")
	self.ScreenGui.Name = "LibraryUI"
	self.ScreenGui.IgnoreGuiInset = true
	self.ScreenGui.ResetOnSpawn = false
	self.ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	self.ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	return self
end

--// Window
function Library:CreateWindow(config)
	config = config or {}
	local Window = {}
	Window.Tabs = {}
	Window.CurrentTab = nil

	--// Main Frame
	local MainFrame = Instance.new("Frame")
	MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	MainFrame.Size = UDim2.new(0, 820, 0, 520)
	MainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	MainFrame.BorderSizePixel = 0
	MainFrame.Parent = self.ScreenGui

	local Corner = Instance.new("UICorner", MainFrame)
	Corner.CornerRadius = UDim.new(0, 10)

	local Stroke = Instance.new("UIStroke", MainFrame)
	Stroke.Color = Color3.fromRGB(30, 30, 30)
	Stroke.Thickness = 1

	--// Aspect + Scale (REFERENCE FIX)
	local Aspect = Instance.new("UIAspectRatioConstraint", MainFrame)
	Aspect.AspectRatio = 1.55

	local UIScale = Instance.new("UIScale", MainFrame)
	UIScale.Scale = 1

	local function UpdateScale()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local size = cam.ViewportSize
		UIScale.Scale = math.clamp(size.Y / 900, 0.85, 1.1)
	end

	UpdateScale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)

	--// Drag
	do
		local dragging, dragStart, startPos
		MainFrame.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				dragStart = i.Position
				startPos = MainFrame.Position
			end
		end)

		UserInputService.InputChanged:Connect(function(i)
			if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = i.Position - dragStart
				MainFrame.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end)

		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end)
	end

	--// Sidebar
	local Sidebar = Instance.new("Frame", MainFrame)
	Sidebar.Position = UDim2.new(0.015, 0, 0.5, 0)
	Sidebar.AnchorPoint = Vector2.new(0, 0.5)
	Sidebar.Size = UDim2.new(0.23, 0, 0.96, 0)
	Sidebar.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	Sidebar.BorderSizePixel = 0

	Instance.new("UICorner", Sidebar).CornerRadius = UDim.new(0, 10)
	Instance.new("UIStroke", Sidebar).Color = Color3.fromRGB(25,25,25)

	local TabContainer = Instance.new("Frame", Sidebar)
	TabContainer.BackgroundTransparency = 1
	TabContainer.Size = UDim2.new(1, -20, 1, -20)
	TabContainer.Position = UDim2.new(0, 10, 0, 10)

	local TabLayout = Instance.new("UIListLayout", TabContainer)
	TabLayout.Padding = UDim.new(0, 8)

	--// Content Holder
	local ContentFolder = Instance.new("Folder", MainFrame)

	--// Create Tab
	function Window:CreateTab(name)
		local Tab = {}

		-- Button
		local Button = Instance.new("Frame", TabContainer)
		Button.Size = UDim2.new(1, 0, 0, 34)
		Button.BackgroundColor3 = Color3.fromRGB(15,15,15)
		Button.BorderSizePixel = 0

		Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)

		local Label = Instance.new("TextLabel", Button)
		Label.BackgroundTransparency = 1
		Label.Size = UDim2.new(1, -20, 1, 0)
		Label.Position = UDim2.new(0, 10, 0, 0)
		Label.Font = Enum.Font.Code
		Label.Text = name
		Label.TextSize = 14
		Label.TextXAlignment = Left
		Label.TextColor3 = Color3.fromRGB(150,150,150)

		local Click = Instance.new("TextButton", Button)
		Click.BackgroundTransparency = 1
		Click.Size = UDim2.new(1,0,1,0)
		Click.Text = ""

		-- Content
		local Frame = Instance.new("Frame", ContentFolder)
		Frame.Position = UDim2.new(0.26, 0, 0, 0)
		Frame.Size = UDim2.new(0.74, 0, 1, 0)
		Frame.BackgroundTransparency = 1
		Frame.Visible = false

		local Container = Instance.new("Frame", Frame)
		Container.AnchorPoint = Vector2.new(0,0.5)
		Container.Position = UDim2.new(0,0,0.5,0)
		Container.Size = UDim2.new(0.48,0,0.96,0)
		Container.BackgroundColor3 = Color3.fromRGB(10,10,10)
		Container.BorderSizePixel = 0

		Instance.new("UICorner", Container).CornerRadius = UDim.new(0,10)
		Instance.new("UIStroke", Container).Color = Color3.fromRGB(25,25,25)

		local Layout = Instance.new("UIListLayout", Container)
		Layout.Padding = UDim.new(0,6)

		local Padding = Instance.new("UIPadding", Container)
		Padding.PaddingLeft = UDim.new(0,10)
		Padding.PaddingRight = UDim.new(0,10)
		Padding.PaddingTop = UDim.new(0,10)

		-- Switch
		local function Select()
			for _, t in pairs(Window.Tabs) do
				t.Frame.Visible = false
				t.Label.TextColor3 = Color3.fromRGB(150,150,150)
			end
			Frame.Visible = true
			Label.TextColor3 = Color3.fromRGB(255,255,255)
			Window.CurrentTab = Tab
		end

		Click.MouseButton1Click:Connect(Select)

		if not Window.CurrentTab then
			task.delay(0.05, Select)
		end

		-- Section
		function Tab:AddSection(text)
			local S = Instance.new("Frame", Container)
			S.Size = UDim2.new(1,0,0,28)
			S.BackgroundColor3 = Color3.fromRGB(20,20,20)
			S.BorderSizePixel = 0

			Instance.new("UICorner", S).CornerRadius = UDim.new(0,8)

			local L = Instance.new("TextLabel", S)
			L.BackgroundTransparency = 1
			L.Size = UDim2.new(1,-10,1,0)
			L.Position = UDim2.new(0,10,0,0)
			L.Font = Enum.Font.Code
			L.Text = text
			L.TextSize = 13
			L.TextXAlignment = Left
			L.TextColor3 = Color3.fromRGB(255,255,255)
		end

		-- Toggle
		function Tab:AddToggle(cfg)
			cfg = cfg or {}
			local T = Instance.new("Frame", Container)
			T.Size = UDim2.new(1,0,0,34)
			T.BackgroundColor3 = Color3.fromRGB(15,15,15)
			T.BorderSizePixel = 0

			Instance.new("UICorner", T).CornerRadius = UDim.new(0,8)

			local Box = Instance.new("Frame", T)
			Box.Size = UDim2.new(0,22,0,22)
			Box.Position = UDim2.new(0,8,0.5,-11)
			Box.BackgroundColor3 = Color3.fromRGB(20,20,20)
			Box.BorderSizePixel = 0

			Instance.new("UICorner", Box).CornerRadius = UDim.new(0,6)

			local Text = Instance.new("TextLabel", T)
			Text.BackgroundTransparency = 1
			Text.Position = UDim2.new(0,40,0,0)
			Text.Size = UDim2.new(1,-40,1,0)
			Text.Font = Enum.Font.Code
			Text.Text = cfg.Name or "Toggle"
			Text.TextSize = 13
			Text.TextXAlignment = Left
			Text.TextColor3 = Color3.fromRGB(255,255,255)

			local Btn = Instance.new("TextButton", T)
			Btn.BackgroundTransparency = 1
			Btn.Size = UDim2.new(1,0,1,0)
			Btn.Text = ""

			local On = cfg.Default or false

			local function Refresh()
				Tween(Box, TweenInfo.new(0.15), {
					BackgroundColor3 = On and Color3.fromRGB(66,150,250) or Color3.fromRGB(20,20,20)
				})
				if cfg.Callback then
					cfg.Callback(On)
				end
			end

			Btn.MouseButton1Click:Connect(function()
				On = not On
				Refresh()
			end)

			Refresh()
		end

		Window.Tabs[name] = {
			Frame = Frame,
			Label = Label,
			Tab = Tab
		}

		return Tab
	end

	return Window
end

return Library
