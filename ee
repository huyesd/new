					currentValue = math.floor(min + (max - min) * pos)
					ValueLabel.Text = tostring(currentValue)
					Tween(SliderFill, TweenInfo.new(0.1), {Size = UDim2.new(pos, 0, 1, 0)})
					callback(currentValue)
				end
				
				SliderTrack.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						dragging = true
						UpdateSlider(input)
					end
				end)
				
				UserInputService.InputChanged:Connect(function(input)
					if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
						UpdateSlider(input)
					end
				end)
				
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						dragging = false
					end
				end)
				
				return {
					Set = function(self, value)
						currentValue = math.clamp(value, min, max)
						ValueLabel.Text = tostring(currentValue)
						local pos = (currentValue - min) / (max - min)
						Tween(SliderFill, TweenInfo.new(0.2), {Size = UDim2.new(pos, 0, 1, 0)})
						callback(currentValue)
					end
				}
			end
			
			function Section:AddDropdown(config)
				config = config or {}
				local name = config.Name or "Example Dropdown"
				local options = config.Options or {"Option 1", "Option 2", "Option 3"}
				local default = config.Default or options[1]
				local multi = config.Multi or false
				local callback = config.Callback or function() end
				
				local DropdownContainer = Instance.new("ImageLabel")
				DropdownContainer.Name = "DropdownContainer"
				DropdownContainer.BackgroundTransparency = 1
				DropdownContainer.Size = UDim2.new(0.979, 0, 0.031, 0)
				DropdownContainer.ClipsDescendants = false
				DropdownContainer.ZIndex = 5
				DropdownContainer.Parent = ContentContainer
				
				local DropdownCorner = Instance.new("UICorner")
				DropdownCorner.CornerRadius = UDim.new(0.1, 0)
				DropdownCorner.Parent = DropdownContainer
				
				local DropdownPadding = Instance.new("UIPadding")
				DropdownPadding.PaddingLeft = UDim.new(0.01, 0)
				DropdownPadding.Parent = DropdownContainer
				
				local DropdownHeader = Instance.new("Frame")
				DropdownHeader.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
				DropdownHeader.BorderSizePixel = 0
				DropdownHeader.Size = UDim2.new(1, 0, 1, 0)
				DropdownHeader.ZIndex = 5
				DropdownHeader.Parent = DropdownContainer
				
				local HeaderCorner = Instance.new("UICorner")
				HeaderCorner.CornerRadius = UDim.new(0.1, 0)
				HeaderCorner.Parent = DropdownHeader
				
				local HeaderStroke = Instance.new("UIStroke")
				HeaderStroke.Color = Color3.fromRGB(40, 40, 40)
				HeaderStroke.Thickness = 1
				HeaderStroke.Parent = DropdownHeader
				
				local DropdownLabel = Instance.new("TextLabel")
				DropdownLabel.BackgroundTransparency = 1
				DropdownLabel.Position = UDim2.new(0.02, 0, 0, 0)
				DropdownLabel.Size = UDim2.new(0.55, 0, 1, 0)
				DropdownLabel.Font = Enum.Font.Code
				DropdownLabel.Text = name
				DropdownLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				DropdownLabel.TextSize = 12
				DropdownLabel.TextWrapped = true
				DropdownLabel.TextTruncate = Enum.TextTruncate.AtEnd
				DropdownLabel.TextXAlignment = Enum.TextXAlignment.Left
				DropdownLabel.TextYAlignment = Enum.TextYAlignment.Center
				DropdownLabel.ZIndex = 6
				DropdownLabel.Parent = DropdownHeader
				
				local CurrentValue = Instance.new("TextLabel")
				CurrentValue.BackgroundTransparency = 1
				CurrentValue.Position = UDim2.new(0.58, 0, 0, 0)
				CurrentValue.Size = UDim2.new(0.4, 0, 1, 0)
				CurrentValue.Font = Enum.Font.Code
				CurrentValue.Text = multi and "..." or default
				CurrentValue.TextColor3 = Color3.fromRGB(150, 150, 150)
				CurrentValue.TextSize = 12
				CurrentValue.TextWrapped = true
				CurrentValue.TextTruncate = Enum.TextTruncate.AtEnd
				CurrentValue.TextXAlignment = Enum.TextXAlignment.Right
				CurrentValue.TextYAlignment = Enum.TextYAlignment.Center
				CurrentValue.ZIndex = 6
				CurrentValue.Parent = DropdownHeader
				
				local DropdownButton = Instance.new("TextButton")
				DropdownButton.BackgroundTransparency = 1
				DropdownButton.Size = UDim2.new(1, 0, 1, 0)
				DropdownButton.Text = ""
				DropdownButton.ZIndex = 7
				DropdownButton.Parent = DropdownHeader
				
				local DropdownList = Instance.new("Frame")
				DropdownList.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				DropdownList.BorderSizePixel = 0
				DropdownList.Position = UDim2.new(0, 0, 1.1, 0)
				DropdownList.Size = UDim2.new(1, 0, 0, 0)
				DropdownList.ClipsDescendants = false
				DropdownList.Visible = false
				DropdownList.ZIndex = 10
				DropdownList.Parent = DropdownContainer
				
				local ListCorner = Instance.new("UICorner")
				ListCorner.CornerRadius = UDim.new(0.1, 0)
				ListCorner.Parent = DropdownList
				
				local ListStroke = Instance.new("UIStroke")
				ListStroke.Color = Color3.fromRGB(40, 40, 40)
				ListStroke.Thickness = 1
				ListStroke.Parent = DropdownList
				
				local ListLayout = Instance.new("UIListLayout")
				ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
				ListLayout.Padding = UDim.new(0, 2)
				ListLayout.Parent = DropdownList
				
				local isOpen = false
				local selectedOptions = multi and {} or default
				
				local function CloseDropdown()
					isOpen = false
					Tween(DropdownList, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 0)})
					task.wait(0.2)
					DropdownList.Visible = false
				end
				
				local function OpenDropdown()
					isOpen = true
					DropdownList.Visible = true
					local targetHeight = #options * 25 + (#options - 1) * 2
					Tween(DropdownList, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetHeight)})
				end
				
				DropdownButton.MouseButton1Click:Connect(function()
					if isOpen then
						CloseDropdown()
					else
						OpenDropdown()
					end
				end)
				
				for _, option in ipairs(options) do
					local OptionButton = Instance.new("TextButton")
					OptionButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
					OptionButton.BorderSizePixel = 0
					OptionButton.Size = UDim2.new(1, 0, 0, 25)
					OptionButton.Font = Enum.Font.Code
					OptionButton.Text = option
					OptionButton.TextColor3 = Color3.fromRGB(200, 200, 200)
					OptionButton.TextSize = 12
					OptionButton.ZIndex = 11
					OptionButton.Parent = DropdownList
					
					local OptionCorner = Instance.new("UICorner")
					OptionCorner.CornerRadius = UDim.new(0.1, 0)
					OptionCorner.Parent = OptionButton
					
					if multi then
						local selected = false
						
						OptionButton.MouseButton1Click:Connect(function()
							selected = not selected
							
							if selected then
								table.insert(selectedOptions, option)
								OptionButton.BackgroundColor3 = Color3.fromRGB(66, 150, 250)
							else
								for i, v in ipairs(selectedOptions) do
									if v == option then
										table.remove(selectedOptions, i)
										break
									end
								end
								OptionButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
							end
							
							callback(selectedOptions)
						end)
						
						OptionButton.MouseEnter:Connect(function()
							if not selected then
								Tween(OptionButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)})
							end
						end)
						
						OptionButton.MouseLeave:Connect(function()
							if not selected then
								Tween(OptionButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)})
							end
						end)
					else
						OptionButton.MouseButton1Click:Connect(function()
							selectedOptions = option
							CurrentValue.Text = option
							callback(option)
							CloseDropdown()
						end)
						
						OptionButton.MouseEnter:Connect(function()
							Tween(OptionButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)})
						end)
						
						OptionButton.MouseLeave:Connect(function()
							Tween(OptionButton, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)})
						end)
					end
				end
				
				DropdownButton.MouseEnter:Connect(function()
					Tween(DropdownHeader, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)})
				end)
				
				DropdownButton.MouseLeave:Connect(function()
					Tween(DropdownHeader, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)})
				end)
				
				return {
					Set = function(self, value)
						selectedOptions = value
						CurrentValue.Text = multi and "..." or value
						callback(value)
					end
				}
			end
			
			Tab.Sections[sectionName] = Section
			TabSections[side] = Section
			return Section
		end
		
		Window.Tabs[tabName] = {
			Frame = TabFrame,
			Button = TabButton,
			Tab = Tab
		}
		
		if not Window.CurrentTab then
			task.wait(0.1)
			SwitchToTab()
		end
		
		return Tab
	end
	
	return Window
end

return Library
