	KeybindList.BorderSizePixel = 0
	KeybindList.Position = UDim2.new(1, -210, 0, 10)
	KeybindList.Size = UDim2.new(0, 200, 0, 25)
	KeybindList.Parent = self.ScreenGui
	
	local KBCorner = Instance.new("UICorner")
	KBCorner.CornerRadius = UDim.new(0, 6)
	KBCorner.Parent = KeybindList
	
	local KBStroke = Instance.new("UIStroke")
	KBStroke.Color = self.Theme.Border
	KBStroke.Thickness = 1
	KBStroke.Parent = KeybindList
	
	local KBTitle = Instance.new("TextLabel")
	KBTitle.BackgroundTransparency = 1
	KBTitle.Size = UDim2.new(1, -10, 0, 25)
	KBTitle.Position = UDim2.new(0, 5, 0, 0)
	KBTitle.Font = Enum.Font.Code
	KBTitle.Text = "keybinds"
	KBTitle.TextColor3 = self.Theme.Text
	KBTitle.TextSize = 13
	KBTitle.TextXAlignment = Enum.TextXAlignment.Left
	KBTitle.Parent = KeybindList
	
	local KBContainer = Instance.new("Frame")
	KBContainer.BackgroundTransparency = 1
	KBContainer.Position = UDim2.new(0, 5, 0, 30)
	KBContainer.Size = UDim2.new(1, -10, 1, -35)
	KBContainer.Parent = KeybindList
	
	local KBLayout = Instance.new("UIListLayout")
	KBLayout.SortOrder = Enum.SortOrder.LayoutOrder
	KBLayout.Padding = UDim.new(0, 3)
	KBLayout.Parent = KBContainer
	
	local function UpdateSize()
		local contentHeight = KBLayout.AbsoluteContentSize.Y
		KeybindList.Size = UDim2.new(0, 200, 0, math.max(25, contentHeight + 35))
	end
	
	KBLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateSize)
	
	return {
		AddKeybind = function(name, key)
			local KBItem = Instance.new("Frame")
			KBItem.Name = name
			KBItem.BackgroundTransparency = 1
			KBItem.Size = UDim2.new(1, 0, 0, 18)
			KBItem.Parent = KBContainer
			
			local NameLabel = Instance.new("TextLabel")
			NameLabel.BackgroundTransparency = 1
			NameLabel.Size = UDim2.new(0.6, 0, 1, 0)
			NameLabel.Font = Enum.Font.Code
			NameLabel.Text = name
			NameLabel.TextColor3 = self.Theme.Text
			NameLabel.TextSize = 11
			NameLabel.TextXAlignment = Enum.TextXAlignment.Left
			NameLabel.Parent = KBItem
			
			local KeyLabel = Instance.new("TextLabel")
			KeyLabel.BackgroundTransparency = 1
			KeyLabel.Position = UDim2.new(0.6, 0, 0, 0)
			KeyLabel.Size = UDim2.new(0.4, 0, 1, 0)
			KeyLabel.Font = Enum.Font.Code
			KeyLabel.Text = "[" .. key .. "]"
			KeyLabel.TextColor3 = self.Theme.TextDark
			KeyLabel.TextSize = 11
			KeyLabel.TextXAlignment = Enum.TextXAlignment.Right
			KeyLabel.Parent = KBItem
			
			UpdateSize()
			
			return {
				Remove = function()
					KBItem:Destroy()
					UpdateSize()
				end,
				UpdateKey = function(newKey)
					KeyLabel.Text = "[" .. newKey .. "]"
				end
			}
		end
	}
end

function Library:CreateWindow(config)
	config = config or {}
	local windowName = config.Name or "UI Library"
	
	local Window = {}
	Window.Tabs = {}
	Window.CurrentTab = nil
	
	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "LibraryUI"
	MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	MainFrame.BackgroundColor3 = self.Theme.Background
	MainFrame.BorderSizePixel = 0
	MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	MainFrame.Size = UDim2.new(0, 700, 0, 450)
	MainFrame.Parent = self.ScreenGui
	
	local MainCorner = Instance.new("UICorner")
	MainCorner.CornerRadius = UDim.new(0.02, 0)
	MainCorner.Parent = MainFrame
	
	local MainStroke = Instance.new("UIStroke")
	MainStroke.Color = self.Theme.Border
	MainStroke.Thickness = 1
	MainStroke.Parent = MainFrame
	
	local UIScale = Instance.new("UIScale")
	UIScale.Parent = MainFrame
	
	local function UpdateScale()
		local viewportSize = workspace.CurrentCamera.ViewportSize
		local baseSize = Vector2.new(1920, 1080)
		local scale = math.min(viewportSize.X / baseSize.X, viewportSize.Y / baseSize.Y)
		UIScale.Scale = math.clamp(scale, 0.5, 1.5)
	end
	
	UpdateScale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)
	
	local dragging, dragInput, dragStart, startPos
	MainFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = MainFrame.Position
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			MainFrame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	
	local Sidebar = Instance.new("Frame")
	Sidebar.Name = "SectionGrouper"
	Sidebar.AnchorPoint = Vector2.new(0, 0.5)
	Sidebar.BackgroundColor3 = self.Theme.Background
	Sidebar.BorderSizePixel = 0
	Sidebar.Position = UDim2.new(0.013, 0, 0.5, 0)
	Sidebar.Size = UDim2.new(0.233, 0, 0.964, 0)
	Sidebar.Parent = MainFrame
	
	local SidebarCorner = Instance.new("UICorner")
	SidebarCorner.CornerRadius = UDim.new(0.05, 0)
	SidebarCorner.Parent = Sidebar
	
	local SidebarStroke = Instance.new("UIStroke")
	SidebarStroke.Color = Color3.fromRGB(25, 25, 25)
	SidebarStroke.Thickness = 1
	SidebarStroke.Parent = Sidebar
	
	local TabContainer = Instance.new("Frame")
	TabContainer.Name = "Container"
	TabContainer.BackgroundTransparency = 1
	TabContainer.Position = UDim2.new(0.066, 0, 0.014, 0)
	TabContainer.Size = UDim2.new(0.869, 0, 0.973, 0)
	TabContainer.Parent = Sidebar
	
	local TabLayout = Instance.new("UIListLayout")
	TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	TabLayout.Padding = UDim.new(0.05, 0)
	TabLayout.Parent = TabContainer
	
	local ContentFolder = Instance.new("Folder")
	ContentFolder.Name = "ContentFolder"
	ContentFolder.Parent = MainFrame
	
	function Window:CreateTab(tabName)
		local Tab = {}
		Tab.Name = tabName
		Tab.Elements = {}
		Tab.Sections = {}
		
		local TabButton = Instance.new("ImageLabel")
		TabButton.Name = tabName .. "Tab"
		TabButton.BackgroundTransparency = 1
		TabButton.Size = UDim2.new(1, 0, 0.065, 0)
		TabButton.Image = "rbxassetid://88501147012996"
		TabButton.ImageTransparency = 1
		TabButton.ScaleType = Enum.ScaleType.Slice
		TabButton.Parent = TabContainer
		
		local TabLabel = Instance.new("TextLabel")
		TabLabel.BackgroundTransparency = 1
		TabLabel.Position = UDim2.new(0.245, 0, 0.139, 0)
		TabLabel.Size = UDim2.new(0.5, 0, 0.77, 0)
		TabLabel.Font = Enum.Font.Code
		TabLabel.Text = tabName
		TabLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		TabLabel.TextSize = 14
		TabLabel.TextXAlignment = Enum.TextXAlignment.Center
		TabLabel.Parent = TabButton
		
		local ClickButton = Instance.new("TextButton")
		ClickButton.Name = "Button"
		ClickButton.BackgroundTransparency = 1
		ClickButton.Size = UDim2.new(1, 0, 1, 0)
		ClickButton.Text = ""
		ClickButton.Parent = TabButton
		
		local TabFrame = Instance.new("Frame")
		TabFrame.Name = tabName .. "Content"
		TabFrame.BackgroundTransparency = 1
		TabFrame.ClipsDescendants = false
		TabFrame.Position = UDim2.new(0.256, 0, 0, 0)
		TabFrame.Size = UDim2.new(0.744, 0, 1, 0)
		TabFrame.Visible = false
		TabFrame.Parent = ContentFolder
		
		local ContentPadding = Instance.new("UIPadding")
		ContentPadding.PaddingLeft = UDim.new(0.01, 0)
		ContentPadding.PaddingTop = UDim.new(0.018, 0)
		ContentPadding.Parent = TabFrame
		
		local TabSections = {
			Left = nil,
			Right = nil
		}
		
		local function SwitchToTab()
			for _, tab in pairs(Window.Tabs) do
				tab.Frame.Visible = false
				local label = tab.Button:FindFirstChild("TextLabel")
				if label then
					label.TextColor3 = Color3.fromRGB(150, 150, 150)
				end
				Tween(tab.Button, TweenInfo.new(0.2), {ImageTransparency = 1})
			end
			
			TabFrame.Visible = true
			TabLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			Tween(TabButton, TweenInfo.new(0.2), {ImageTransparency = 0})
			Window.CurrentTab = Tab
		end
		
		ClickButton.MouseButton1Click:Connect(SwitchToTab)
		
		ClickButton.MouseEnter:Connect(function()
			if Window.CurrentTab ~= Tab then
				Tween(TabLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(200, 200, 200)})
			end
		end)
		
		ClickButton.MouseLeave:Connect(function()
			if Window.CurrentTab ~= Tab then
				Tween(TabLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
			end
		end)
		
		function Tab:CreateSection(sectionName, side)
			side = side or "Left"
			
