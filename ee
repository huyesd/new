    HueBar.Parent = PickerWindow

    local HueCorner = Instance.new("UICorner")
    HueCorner.CornerRadius = UDim.new(0, 4)
    HueCorner.Parent = HueBar

    -- Copy/Paste Buttons
    local CopyButton = Instance.new("TextButton")
    CopyButton.Size = UDim2.new(0.48, -7, 0, 25)
    CopyButton.Position = UDim2.new(0, 10, 1, -35)
    CopyButton.BackgroundColor3 = CONFIG.SecondaryColor
    CopyButton.Text = "Copy"
    CopyButton.TextColor3 = CONFIG.TextColor
    CopyButton.TextSize = 11
    CopyButton.Font = Enum.Font.Gotham
    CopyButton.Parent = PickerWindow

    local CopyCorner = Instance.new("UICorner")
    CopyCorner.CornerRadius = UDim.new(0, 4)
    CopyCorner.Parent = CopyButton

    local PasteButton = Instance.new("TextButton")
    PasteButton.Size = UDim2.new(0.48, -7, 0, 25)
    PasteButton.Position = UDim2.new(0.52, 3, 1, -35)
    PasteButton.BackgroundColor3 = CONFIG.SecondaryColor
    PasteButton.Text = "Paste"
    PasteButton.TextColor3 = CONFIG.TextColor
    PasteButton.TextSize = 11
    PasteButton.Font = Enum.Font.Gotham
    PasteButton.Parent = PickerWindow

    local PasteCorner = Instance.new("UICorner")
    PasteCorner.CornerRadius = UDim.new(0, 4)
    PasteCorner.Parent = PasteButton

    local h, s, v = RGBToHSV(default.R, default.G, default.B)
    local copiedColor = default

    local function updateColor(newH, newS, newV)
        h, s, v = newH or h, newS or s, newV or v
        local r, g, b = HSVToRGB(h, s, v)
        local color = Color3.new(r, g, b)
        
        ColorDisplay.BackgroundColor3 = color
        Canvas.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        
        if callback then
            callback(color)
        end
    end

    Canvas.MouseButton1Down:Connect(function()
        local function update()
            local mouse = game.Players.LocalPlayer:GetMouse()
            local x = math.clamp((mouse.X - Canvas.AbsolutePosition.X) / Canvas.AbsoluteSize.X, 0, 1)
            local y = math.clamp((mouse.Y - Canvas.AbsolutePosition.Y) / Canvas.AbsoluteSize.Y, 0, 1)
            updateColor(nil, x, 1 - y)
        end
        
        update()
        local connection
        connection = game:GetService("RunService").RenderStepped:Connect(function()
            if not game:GetService("UserInputService"):IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                connection:Disconnect()
            else
                update()
            end
        end)
    end)

    HueBar.MouseButton1Down:Connect(function()
        local function update()
            local mouse = game.Players.LocalPlayer:GetMouse()
            local y = math.clamp((mouse.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
            updateColor(1 - y, nil, nil)
        end
        
        update()
        local connection
        connection = game:GetService("RunService").RenderStepped:Connect(function()
            if not game:GetService("UserInputService"):IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                connection:Disconnect()
            else
                update()
            end
        end)
    end)

    CopyButton.MouseButton1Click:Connect(function()
        copiedColor = ColorDisplay.BackgroundColor3
    end)

    PasteButton.MouseButton1Click:Connect(function()
        local h2, s2, v2 = RGBToHSV(copiedColor.R, copiedColor.G, copiedColor.B)
        updateColor(h2, s2, v2)
    end)

    ColorDisplay.MouseButton1Click:Connect(function()
        PickerWindow.Visible = not PickerWindow.Visible
    end)

    table.insert(Tab.Elements, ColorFrame)
    Tab.Content.CanvasSize = UDim2.new(0, 0, 0, Tab.Content.UIListLayout.AbsoluteContentSize.Y + 20)

    return ColorDisplay
end

