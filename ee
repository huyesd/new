			ElementLayout.Padding = UDim.new(0.015, 0)
			ElementLayout.Parent = ContentContainer
			
			-- Auto-resize canvas
			ElementLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				ContentContainer.CanvasSize = UDim2.new(0, 0, 0, ElementLayout.AbsoluteContentSize.Y + 10)
			end)
			
