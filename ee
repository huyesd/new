--[[
    Modern UI Library
    Created for Roblox
    Version 2.0.0
]]

local Library = {}
Library.__index = Library

-- Services
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- Create main library object
function Library:Create(title)
    local UI = {}
    
    -- Create ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ModernUI"
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    
    -- Main Frame
    local LibraryUI = Instance.new("Frame")
    LibraryUI.Name = "LibraryUI"
    LibraryUI.Parent = ScreenGui
    LibraryUI.AnchorPoint = Vector2.new(0.5, 0.5)
    LibraryUI.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    LibraryUI.BorderSizePixel = 0
    LibraryUI.Position = UDim2.new(0.5, 0, 0.5, 0)
    LibraryUI.Size = UDim2.new(0, 550, 0, 400)
    
    -- UI Stroke for main frame
    local MainStroke = Instance.new("UIStroke")
    MainStroke.Parent = LibraryUI
    MainStroke.Color = Color3.fromRGB(40, 40, 40)
    MainStroke.Thickness = 1
    
    local MainCorner = Instance.new("UICorner")
    MainCorner.Parent = LibraryUI
    MainCorner.CornerRadius = UDim.new(0, 8)
    
    -- Make draggable
    local dragging, dragInput, dragStart, startPos
    
    LibraryUI.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = LibraryUI.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    LibraryUI.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            LibraryUI.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    -- Tab Container (Left Side)
    local SectionGrouper = Instance.new("Frame")
    SectionGrouper.Name = "SectionGrouper"
    SectionGrouper.Parent = LibraryUI
    SectionGrouper.AnchorPoint = Vector2.new(0, 0.5)
    SectionGrouper.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    SectionGrouper.BorderSizePixel = 0
    SectionGrouper.Position = UDim2.new(0.013, 0, 0.5, 0)
    SectionGrouper.Size = UDim2.new(0.23, 0, 0.96, 0)
    
    local GrouperStroke = Instance.new("UIStroke")
    GrouperStroke.Parent = SectionGrouper
    GrouperStroke.Color = Color3.fromRGB(40, 40, 40)
    GrouperStroke.Thickness = 1
    
    local GrouperCorner = Instance.new("UICorner")
    GrouperCorner.Parent = SectionGrouper
    GrouperCorner.CornerRadius = UDim.new(0, 8)
    
    -- Tab List Container
    local TabListContainer = Instance.new("ScrollingFrame")
    TabListContainer.Name = "Container"
    TabListContainer.Parent = SectionGrouper
    TabListContainer.BackgroundTransparency = 1
    TabListContainer.BorderSizePixel = 0
    TabListContainer.Position = UDim2.new(0.066, 0, 0.014, 0)
    TabListContainer.Size = UDim2.new(0.869, 0, 0.973, 0)
    TabListContainer.ScrollBarThickness = 2
    TabListContainer.ScrollBarImageColor3 = Color3.fromRGB(66, 150, 250)
    
    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.Parent = TabListContainer
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0.05, 0)
    
    -- Tab Content Container
    local TabFolder = Instance.new("Folder")
    TabFolder.Name = "TabFolder"
    TabFolder.Parent = LibraryUI
    
    UI.Tabs = {}
    UI.CurrentTab = nil
    
    function UI:AddTab(name)
        local Tab = {}
        
        -- Tab Button
        local TabButton = Instance.new("ImageLabel")
        TabButton.Name = name .. "Tab"
        TabButton.Parent = TabListContainer
        TabButton.BackgroundTransparency = 1
        TabButton.Size = UDim2.new(1, 0, 0, 39)
        TabButton.Image = "rbxassetid://88501147012996"
        TabButton.ImageTransparency = 1
        TabButton.ScaleType = Enum.ScaleType.Slice
        
        local TabStroke = Instance.new("UIStroke")
        TabStroke.Parent = TabButton
        TabStroke.Color = Color3.fromRGB(40, 40, 40)
        TabStroke.Thickness = 1
        TabStroke.Transparency = 1
        
        local TabCorner = Instance.new("UICorner")
        TabCorner.Parent = TabButton
        TabCorner.CornerRadius = UDim.new(0.1, 0)
        
        local TabLabel = Instance.new("TextLabel")
        TabLabel.Parent = TabButton
        TabLabel.BackgroundTransparency = 1
        TabLabel.Position = UDim2.new(0.245, 0, 0.139, 0)
        TabLabel.Size = UDim2.new(0, 69, 0, 30)
        TabLabel.Font = Enum.Font.Gotham
        TabLabel.Text = name
        TabLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        TabLabel.TextSize = 14
        TabLabel.TextWrapped = true
        
        local TabButtonClick = Instance.new("TextButton")
        TabButtonClick.Name = "Button"
        TabButtonClick.Parent = TabButton
        TabButtonClick.BackgroundTransparency = 1
        TabButtonClick.Size = UDim2.new(1, 0, 1, 0)
        TabButtonClick.Font = Enum.Font.SourceSans
        TabButtonClick.Text = ""
        TabButtonClick.TextTransparency = 1
        
        -- Tab Content Frame
        local TabContent = Instance.new("Frame")
        TabContent.Name = name .. "Content"
        TabContent.Parent = TabFolder
        TabContent.BackgroundTransparency = 1
        TabContent.Position = UDim2.new(0.256, 0, 0, 0)
        TabContent.Size = UDim2.new(0.744, 0, 1, 0)
        TabContent.Visible = false
        TabContent.ClipsDescendants = true
        
        local ContentPadding = Instance.new("UIPadding")
        ContentPadding.Parent = TabContent
        ContentPadding.PaddingLeft = UDim.new(0.01, 0)
        ContentPadding.PaddingTop = UDim.new(0.018, 0)
        
        local ContentLayout = Instance.new("UIListLayout")
        ContentLayout.Parent = TabContent
        ContentLayout.FillDirection = Enum.FillDirection.Horizontal
        ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ContentLayout.Padding = UDim.new(0.01, 0)
        
        -- Sections container
        Tab.Sections = {}
        
        TabButtonClick.MouseButton1Click:Connect(function()
            for _, tab in pairs(UI.Tabs) do
                tab.Content.Visible = false
                tab.Button.ImageTransparency = 1
                tab.Label.TextColor3 = Color3.fromRGB(150, 150, 150)
                tab.Stroke.Transparency = 1
            end
            
            TabContent.Visible = true
            TabButton.ImageTransparency = 0
            TabLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            TabStroke.Transparency = 0
            UI.CurrentTab = Tab
        end)
        
        Tab.Button = TabButton
        Tab.Label = TabLabel
        Tab.Content = TabContent
        Tab.Stroke = TabStroke
        
        function Tab:AddSection(sectionName)
            local Section = {}
            
            local SectionFrame = Instance.new("Frame")
            SectionFrame.Name = "TabContainer"
            SectionFrame.Parent = TabContent
            SectionFrame.AnchorPoint = Vector2.new(0, 0.5)
            SectionFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            SectionFrame.BorderSizePixel = 0
            SectionFrame.ClipsDescendants = true
            SectionFrame.Position = UDim2.new(0, 0, 0.491, 0)
            SectionFrame.Size = UDim2.new(0.481, 0, 0.982, 0)
            
            local SectionStroke = Instance.new("UIStroke")
            SectionStroke.Parent = SectionFrame
            SectionStroke.Color = Color3.fromRGB(40, 40, 40)
            SectionStroke.Thickness = 1
            
            local SectionCorner = Instance.new("UICorner")
            SectionCorner.Parent = SectionFrame
            SectionCorner.CornerRadius = UDim.new(0.04, 0)
            
            local SectionLayout = Instance.new("UIListLayout")
            SectionLayout.Parent = SectionFrame
            SectionLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            SectionLayout.SortOrder = Enum.SortOrder.LayoutOrder
            SectionLayout.Padding = UDim.new(0.015, 0)
            
            -- Section Header
            local SectionHeader = Instance.new("ImageLabel")
            SectionHeader.Name = "SectionContainer"
            SectionHeader.Parent = SectionFrame
            SectionHeader.BackgroundTransparency = 1
            SectionHeader.LayoutOrder = -1
            SectionHeader.Size = UDim2.new(1.111, 0, 0.064, 0)
            SectionHeader.Image = "rbxassetid://74933512721886"
            
            local HeaderStroke = Instance.new("UIStroke")
            HeaderStroke.Parent = SectionHeader
            HeaderStroke.Color = Color3.fromRGB(66, 150, 250)
            HeaderStroke.Thickness = 1
            
            local HeaderCorner = Instance.new("UICorner")
            HeaderCorner.Parent = SectionHeader
            HeaderCorner.CornerRadius = UDim.new(0.1, 0)
            
            local SectionLabel = Instance.new("TextLabel")
            SectionLabel.Parent = SectionHeader
            SectionLabel.BackgroundTransparency = 1
            SectionLabel.Position = UDim2.new(0.034, 0, 0.119, 0)
            SectionLabel.Size = UDim2.new(0.932, 0, 0.713, 0)
            SectionLabel.Font = Enum.Font.GothamBold
            SectionLabel.Text = sectionName
            SectionLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            SectionLabel.TextSize = 14
            SectionLabel.TextWrapped = true
            
            Section.Frame = SectionFrame
            Section.Elements = {}
            
            function Section:AddToggle(name, default, callback)
                callback = callback or function() end
                local toggled = default or false
                
                local ToggleContainer = Instance.new("ImageLabel")
                ToggleContainer.Name = "ToggleContainer"
                ToggleContainer.Parent = SectionFrame
                ToggleContainer.BackgroundTransparency = 1
                ToggleContainer.Size = UDim2.new(0.979, 0, 0.031, 0)
                
                local ToggleStroke = Instance.new("UIStroke")
                ToggleStroke.Parent = ToggleContainer
                ToggleStroke.Color = Color3.fromRGB(40, 40, 40)
                ToggleStroke.Thickness = 1
                
                local ToggleCorner = Instance.new("UICorner")
                ToggleCorner.Parent = ToggleContainer
                ToggleCorner.CornerRadius = UDim.new(0.1, 0)
                
                local TogglePadding = Instance.new("UIPadding")
                TogglePadding.Parent = ToggleContainer
                TogglePadding.PaddingLeft = UDim.new(0.01, 0)
                
                local ToggleLayout = Instance.new("UIListLayout")
                ToggleLayout.Parent = ToggleContainer
                ToggleLayout.FillDirection = Enum.FillDirection.Horizontal
                ToggleLayout.SortOrder = Enum.SortOrder.LayoutOrder
                ToggleLayout.Padding = UDim.new(0.025, 0)
                
                local ToggleBox = Instance.new("Frame")
                ToggleBox.Name = "Toggle"
                ToggleBox.Parent = ToggleContainer
                ToggleBox.BackgroundColor3 = toggled and Color3.fromRGB(66, 150, 250) or Color3.fromRGB(20, 20, 20)
                ToggleBox.BorderSizePixel = 0
                ToggleBox.LayoutOrder = -1
                ToggleBox.Size = UDim2.new(0.068, 0, 0.941, 0)
                
                local ToggleBoxStroke = Instance.new("UIStroke")
                ToggleBoxStroke.Parent = ToggleBox
                ToggleBoxStroke.Color = Color3.fromRGB(66, 150, 250)
                ToggleBoxStroke.Thickness = 1
                
                local ToggleBoxCorner = Instance.new("UICorner")
                ToggleBoxCorner.Parent = ToggleBox
                ToggleBoxCorner.CornerRadius = UDim.new(0.3, 0)
                
                local ToggleIcon = Instance.new("ImageLabel")
                ToggleIcon.Parent = ToggleBox
                ToggleIcon.AnchorPoint = Vector2.new(0.5, 0.5)
                ToggleIcon.BackgroundTransparency = 1
                ToggleIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
                ToggleIcon.Size = UDim2.new(0.7, 0, 0.8, 0)
                ToggleIcon.Image = "rbxassetid://108907458318508"
                ToggleIcon.ImageTransparency = toggled and 0 or 1
                
                local ToggleLabel = Instance.new("TextLabel")
                ToggleLabel.Parent = ToggleContainer
                ToggleLabel.BackgroundTransparency = 1
                ToggleLabel.Position = UDim2.new(0.093, 0, 0, 0)
                ToggleLabel.Size = UDim2.new(0.852, 0, 0.847, 0)
                ToggleLabel.Font = Enum.Font.Gotham
                ToggleLabel.Text = name
                ToggleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                ToggleLabel.TextScaled = true
                ToggleLabel.TextSize = 14
                ToggleLabel.TextWrapped = true
                ToggleLabel.TextXAlignment = Enum.TextXAlignment.Left
                
                local ToggleButton = Instance.new("TextButton")
                ToggleButton.Name = "Toggle"
                ToggleButton.Parent = ToggleBox
                ToggleButton.BackgroundTransparency = 1
                ToggleButton.Size = UDim2.new(1, 0, 1, 0)
                ToggleButton.Font = Enum.Font.SourceSans
                ToggleButton.Text = ""
                ToggleButton.TextTransparency = 1
                
                ToggleButton.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    
                    local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad)
                    local colorTween = TweenService:Create(ToggleBox, tweenInfo, {
                        BackgroundColor3 = toggled and Color3.fromRGB(66, 150, 250) or Color3.fromRGB(20, 20, 20)
                    })
                    local iconTween = TweenService:Create(ToggleIcon, tweenInfo, {
                        ImageTransparency = toggled and 0 or 1
                    })
                    
                    colorTween:Play()
                    iconTween:Play()
                    
                    callback(toggled)
                end)
                
                return {
                    SetValue = function(val)
                        toggled = val
                        ToggleBox.BackgroundColor3 = toggled and Color3.fromRGB(66, 150, 250) or Color3.fromRGB(20, 20, 20)
                        ToggleIcon.ImageTransparency = toggled and 0 or 1
                        callback(toggled)
                    end
                }
            end
            
            function Section:AddSlider(name, min, max, default, callback)
                callback = callback or function() end
                local value = default or min
                
                local SliderContainer = Instance.new("ImageLabel")
                SliderContainer.Name = "SliderContainer"
                SliderContainer.Parent = SectionFrame
                SliderContainer.BackgroundTransparency = 1
                SliderContainer.Size = UDim2.new(0.979, 0, 0.047, 0)
                
                local SliderStroke = Instance.new("UIStroke")
                SliderStroke.Parent = SliderContainer
                SliderStroke.Color = Color3.fromRGB(40, 40, 40)
                SliderStroke.Thickness = 1
                
                local SliderCorner = Instance.new("UICorner")
                SliderCorner.Parent = SliderContainer
                SliderCorner.CornerRadius = UDim.new(0.1, 0)
                
                local SliderPadding = Instance.new("UIPadding")
                SliderPadding.Parent = SliderContainer
                SliderPadding.PaddingLeft = UDim.new(0.01, 0)
                
                local SliderLabel = Instance.new("TextLabel")
                SliderLabel.Parent = SliderContainer
                SliderLabel.BackgroundTransparency = 1
                SliderLabel.Size = UDim2.new(0.852, 0, 0.48, 0)
                SliderLabel.Font = Enum.Font.Gotham
                SliderLabel.Text = name
                SliderLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                SliderLabel.TextScaled = true
                SliderLabel.TextSize = 14
                SliderLabel.TextWrapped = true
                SliderLabel.TextXAlignment = Enum.TextXAlignment.Left
                
                local SliderValue = Instance.new("TextLabel")
                SliderValue.Parent = SliderContainer
                SliderValue.BackgroundTransparency = 1
                SliderValue.Position = UDim2.new(0.877, 0, 0, 0)
                SliderValue.Size = UDim2.new(0.134, 0, 0.48, 0)
                SliderValue.Font = Enum.Font.Gotham
                SliderValue.Text = tostring(value)
                SliderValue.TextColor3 = Color3.fromRGB(255, 255, 255)
                SliderValue.TextScaled = true
                SliderValue.TextSize = 14
                SliderValue.TextWrapped = true
                
                local SliderOuter = Instance.new("Frame")
                SliderOuter.Name = "SliderFrame"
                SliderOuter.Parent = SliderLabel
                SliderOuter.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                SliderOuter.BorderSizePixel = 0
                SliderOuter.ClipsDescendants = true
                SliderOuter.Position = UDim2.new(0, 0, 1.561, 0)
                SliderOuter.Size = UDim2.new(0, 230, 0, 3)
                
                local SliderOuterStroke = Instance.new("UIStroke")
                SliderOuterStroke.Parent = SliderOuter
                SliderOuterStroke.Color = Color3.fromRGB(40, 40, 40)
                SliderOuterStroke.Thickness = 1
                
                local SliderInner = Instance.new("Frame")
                SliderInner.Name = "SliderFrame"
                SliderInner.Parent = SliderOuter
                SliderInner.BackgroundColor3 = Color3.fromRGB(66, 150, 250)
                SliderInner.BorderSizePixel = 0
                SliderInner.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                
                local dragging = false
                
                SliderOuter.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                    end
                end)
                
                SliderOuter.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local mousePos = input.Position.X
                        local sliderPos = SliderOuter.AbsolutePosition.X
                        local sliderSize = SliderOuter.AbsoluteSize.X
                        local percent = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
                        
                        value = math.floor(min + (max - min) * percent)
                        SliderValue.Text = tostring(value)
                        SliderInner.Size = UDim2.new(percent, 0, 1, 0)
                        
                        callback(value)
                    end
                end)
                
                return {
                    SetValue = function(val)
                        value = math.clamp(val, min, max)
                        SliderValue.Text = tostring(value)
                        SliderInner.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                        callback(value)
                    end
                }
            end
            
            table.insert(Tab.Sections, Section)
            return Section
        end
        
        table.insert(UI.Tabs, Tab)
        
        -- Activate first tab by default
        if #UI.Tabs == 1 then
            TabButtonClick.MouseButton1Click:Fire()
        end
        
        return Tab
    end
    
    return UI
end

return Library
