			Checkmark.Parent = ToggleButton
			
			local ToggleLabel = Instance.new("TextLabel")
			ToggleLabel.BackgroundTransparency = 1
			ToggleLabel.Position = UDim2.new(0.073, 0, 0.118, 0)
			ToggleLabel.Size = UDim2.new(0.852, 0, 0.824, 0)
			ToggleLabel.Font = Enum.Font.Code
			ToggleLabel.Text = name
			ToggleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			ToggleLabel.TextScaled = true
			ToggleLabel.TextXAlignment = Enum.TextXAlignment.Left
			ToggleLabel.Parent = ToggleContainer
			
			local toggled = default
			
			local function UpdateToggle()
				if toggled then
					Tween(ToggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(66, 150, 250)})
					Tween(Checkmark, TweenInfo.new(0.2), {ImageTransparency = 0})
				else
					Tween(ToggleFrame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)})
					Tween(Checkmark, TweenInfo.new(0.2), {ImageTransparency = 1})
				end
				callback(toggled)
			end
			
			UpdateToggle()
			
			ToggleButton.MouseButton1Click:Connect(function()
				toggled = not toggled
				UpdateToggle()
			end)
			
			ToggleButton.MouseEnter:Connect(function()
				if toggled then
					Tween(ToggleFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(76, 160, 255)})
				else
					Tween(ToggleFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)})
				end
			end)
			
			ToggleButton.MouseLeave:Connect(function()
				if toggled then
					Tween(ToggleFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(66, 150, 250)})
				else
					Tween(ToggleFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(20, 20, 20)})
				end
			end)
			
			return {
				Set = function(value)
					toggled = value
					UpdateToggle()
				end
			}
		end
		
		function Tab:AddSlider(config)
			config = config or {}
			local name = config.Name or "Example Slider"
			local min = config.Min or 0
			local max = config.Max or 100
			local default = config.Default or 50
			local callback = config.Callback or function() end
			
			local SliderContainer = Instance.new("ImageLabel")
			SliderContainer.Name = "SliderContainer"
			SliderContainer.BackgroundTransparency = 1
			SliderContainer.Size = UDim2.new(0.979, 0, 0.047, 0)
