    ColorFrame.Name = "ColorPicker"
    ColorFrame.Size = UDim2.new(1, 0, 0, 30)
    ColorFrame.BackgroundTransparency = 1
    ColorFrame.Visible = Tab.Active
    ColorFrame.Parent = Tab.Content

    local ColorLabel = Instance.new("TextLabel")
    ColorLabel.Size = UDim2.new(1, -40, 1, 0)
    ColorLabel.BackgroundTransparency = 1
    ColorLabel.Text = text
    ColorLabel.TextColor3 = CONFIG.TextColor
    ColorLabel.TextSize = 13
    ColorLabel.TextXAlignment = Enum.TextXAlignment.Left
    ColorLabel.Font = Enum.Font.Gotham
    ColorLabel.Parent = ColorFrame

    local ColorDisplay = Instance.new("TextButton")
    ColorDisplay.Size = UDim2.new(0, 35, 0, 18)
    ColorDisplay.Position = UDim2.new(1, -35, 0.5, -9)
    ColorDisplay.BackgroundColor3 = default or Color3.fromRGB(100, 200, 100)
    ColorDisplay.Text = ""
    ColorDisplay.Parent = ColorFrame

    local ColorCorner = Instance.new("UICorner")
