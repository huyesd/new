local Library = {}

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = game.Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

function Library:CreateWindow(title)
    local ModernUI = Instance.new("ScreenGui")
    ModernUI.Name = title or "ModernUI"
    ModernUI.Parent = (game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui"))
    ModernUI.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ModernUI
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.Size = UDim2.new(0, 800, 0, 500)
    Instance.new("UICorner", MainFrame)
    
    local NotificationContainer = Instance.new("Frame")
    NotificationContainer.Name = "NotificationContainer"
    NotificationContainer.Parent = ModernUI
    NotificationContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    NotificationContainer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    NotificationContainer.BackgroundTransparency = 1
    NotificationContainer.Position = UDim2.new(0.102, 0,0.268, 0)
    NotificationContainer.Size = UDim2.new(0.197, 0,0.389, 0)
    
    Instance.new("UIListLayout", NotificationContainer).Padding = UDim.new(0.01, 0)

    local dragging, dragInput, dragStart, startPos

    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    MainFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Parent = MainFrame
    Sidebar.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    Sidebar.Size = UDim2.new(0, 180, 1, 0)
    Instance.new("UICorner", Sidebar)

    local SidebarList = Instance.new("UIListLayout", Sidebar)
    SidebarList.Padding = UDim.new(0, 4)
    SidebarList.SortOrder = Enum.SortOrder.LayoutOrder

    local SidebarPadding = Instance.new("UIPadding", Sidebar)
    SidebarPadding.PaddingLeft = UDim.new(0, 15)
    SidebarPadding.PaddingRight = UDim.new(0, 15)
    SidebarPadding.PaddingTop = UDim.new(0, 20)

    local ContentFrame = Instance.new("Frame")
    ContentFrame.Name = "ContentFrame"
    ContentFrame.Parent = MainFrame
    ContentFrame.BackgroundTransparency = 1
    ContentFrame.Position = UDim2.new(0, 190, 0, 20)
    ContentFrame.Size = UDim2.new(0, 590, 1, -40)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
            ModernUI.Enabled = not ModernUI.Enabled
        end
    end)
    
    -- Replace the Library:Notify function with this smooth version
    function Library:Notify(text, timeV)
        local Notification = Instance.new("Frame", NotificationContainer)
        Notification.Name = "Notification"
        Notification.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        Notification.AnchorPoint = Vector2.new(0.5, 0.5)
        Notification.Size = UDim2.new(0, 0, 0.14, 0)
        Notification.BackgroundTransparency = 1
        Instance.new("UICorner", Notification).CornerRadius = UDim.new(0, 8)

        local BarHolder = Instance.new("Frame", Notification)
        BarHolder.Name = "BarHolder"
        BarHolder.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        BarHolder.Size = UDim2.new(0.944, 0, 0.052, 0)
        BarHolder.Position = UDim2.new(0.037, 0, 0.824, 0)
        BarHolder.ClipsDescendants = true
        Instance.new("UICorner", BarHolder).CornerRadius = UDim.new(0, 8)

        local Bar = Instance.new("Frame", BarHolder)
        Bar.Name = "Bar"
        Bar.BackgroundColor3 = Color3.fromRGB(66, 150, 250)
        Bar.Size = UDim2.new(0, 0, 1, 0)
        Bar.Position = UDim2.new(0, 0, 0, 0)
        Instance.new("UICorner", Bar).CornerRadius = UDim.new(0, 8)

        local Title = Instance.new("TextLabel", Notification)
        Title.Name = "Title"
        Title.BackgroundTransparency = 1
        Title.Size = UDim2.new(0.944, 0, 0.233, 0)
        Title.Position = UDim2.new(0.037, 0, 0.121, 0)
        Title.Font = Enum.Font.GothamMedium
        Title.TextColor3 = Color3.fromRGB(255, 255, 255)
        Title.Text = title
        Title.TextSize = 14
        Title.TextScaled = true
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.TextYAlignment = Enum.TextYAlignment.Top
        Title.TextTransparency = 1

        local Description = Instance.new("TextLabel", Notification)
        Description.Name = "Description"
        Description.BackgroundTransparency = 1
        Description.Size = UDim2.new(0.944, 0, 0.316, 0)
        Description.Position = UDim2.new(0.037, 0, 0.448, 0)
        Description.Font = Enum.Font.Gotham
        Description.TextColor3 = Color3.fromRGB(200, 200, 200)
        Description.Text = text
        Description.TextSize = 12
        Description.TextXAlignment = Enum.TextXAlignment.Left
        Description.TextYAlignment = Enum.TextYAlignment.Top
        Description.TextWrapped = true
        Description.TextTransparency = 1

        local function close()
            local fadeTweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

            -- Fade out text
            TweenService:Create(Title, fadeTweenInfo, {TextTransparency = 1}):Play()
            TweenService:Create(Description, fadeTweenInfo, {TextTransparency = 1}):Play()

            -- Fade and shrink notification
            local closeTween = TweenService:Create(Notification, fadeTweenInfo, {
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 0, 0.14, 0)
            })
            closeTween:Play()

            closeTween.Completed:Connect(function()
                Notification:Destroy()
            end)
        end

        -- Smooth open animation with fade in
        local openTweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

        -- Animate size
        local openTween = TweenService:Create(Notification, openTweenInfo, {
            Size = UDim2.new(1, 0, 0.14, 0),
            BackgroundTransparency = 0
        })
        openTween:Play()

        -- Fade in text with slight delay for smoothness
        wait(0.1)
        local textFadeTweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(Title, textFadeTweenInfo, {TextTransparency = 0}):Play()
        TweenService:Create(Description, textFadeTweenInfo, {TextTransparency = 0}):Play()

        -- Smooth progress bar animation
        local barTween = TweenService:Create(Bar, TweenInfo.new(timeV, Enum.EasingStyle.Linear), {
            Size = UDim2.new(1, 0, 1, 0)
        })
        barTween:Play()

        barTween.Completed:Connect(function()
            wait(0.2)
            close()
        end)
    end

    local Tabs = {}
    function Tabs:CreateTab(name)
        local TabButton = Instance.new("TextButton")
        TabButton.Parent = Sidebar
        TabButton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        TabButton.Size = UDim2.new(1, 0, 0, 35)
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.Text = name
        TabButton.TextColor3 = Color3.fromRGB(150, 150, 150)
        TabButton.TextSize = 14
        Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 6)

        local TabPage = Instance.new("Frame")
        TabPage.Name = name .. "Tab"
        TabPage.Parent = ContentFrame
        TabPage.BackgroundTransparency = 1
        TabPage.Size = UDim2.new(1, 0, 1, 0)
        TabPage.Visible = false

        local PageLayout = Instance.new("UIListLayout", TabPage)
        PageLayout.FillDirection = Enum.FillDirection.Horizontal
        PageLayout.Padding = UDim.new(0, 15)

        TabButton.MouseButton1Click:Connect(function()
            for _, v in pairs(ContentFrame:GetChildren()) do 
                if v:IsA("Frame") then
                    v.Visible = false 
                end
            end
            for _, v in pairs(Sidebar:GetChildren()) do 
                if v:IsA("TextButton") then 
                    TweenService:Create(v, TweenInfo.new(0.2), {
                        TextColor3 = Color3.fromRGB(150,150,150), 
                        BackgroundColor3 = Color3.fromRGB(15,15,15)
                    }):Play()
                end 
            end
            TabPage.Visible = true
            TweenService:Create(TabButton, TweenInfo.new(0.2), {
                TextColor3 = Color3.fromRGB(255,255,255), 
                BackgroundColor3 = Color3.fromRGB(25,25,25)
            }):Play()
        end)

        local Sections = {}
        function Sections:CreateSection(secName)
            local Column = Instance.new("Frame")
            Column.Parent = TabPage
            Column.BackgroundTransparency = 1
            Column.Size = UDim2.new(0.32, 0, 1, 0)

            local ColLayout = Instance.new("UIListLayout", Column)
            ColLayout.Padding = UDim.new(0, 6)
            ColLayout.SortOrder = Enum.SortOrder.LayoutOrder

            local Header = Instance.new("TextLabel")
            Header.Parent = Column
            Header.Text = secName:lower()
            Header.LayoutOrder = -15
            Header.Font = Enum.Font.GothamBold
            Header.TextColor3 = Color3.fromRGB(255, 255, 255)
            Header.TextSize = 15
            Header.BackgroundTransparency = 1
            Header.Size = UDim2.new(1, 0, 0, 30)
            Header.TextXAlignment = Enum.TextXAlignment.Left

            local Elements = {}

            function Elements:CreateToggle(text, callback)
                local ToggFrame = Instance.new("Frame", Column)
                ToggFrame.BackgroundTransparency = 1
                ToggFrame.Size = UDim2.new(1, 0, 0, 30)

                local Box = Instance.new("Frame", ToggFrame)
                Box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                Box.Size = UDim2.new(0, 18, 0, 18)
                Box.Position = UDim2.new(0, 0, 0.5, -9)
                Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)
                Instance.new("UIStroke", Box).Color = Color3.fromRGB(60,60,60)

                local Check = Instance.new("ImageLabel", Box)
                Check.Image = "rbxassetid://99733796490102"
                Check.ImageColor3 = Color3.fromRGB(255, 255, 255)
                Check.BackgroundTransparency = 1
                Check.ImageTransparency = 1
                Check.Size = UDim2.new(0.7, 0, 0.7, 0)
                Check.AnchorPoint = Vector2.new(0.5, 0.5)
                Check.Position = UDim2.new(0.5, 0, 0.5, 0)
                Check.Visible = false

                local Label = Instance.new("TextLabel", ToggFrame)
                Label.Text = text
                Label.Font = Enum.Font.Gotham
                Label.TextColor3 = Color3.fromRGB(255, 255, 255)
                Label.TextSize = 13
                Label.Position = UDim2.new(0, 25, 0, 0)
                Label.Size = UDim2.new(1, -25, 1, 0)
                Label.BackgroundTransparency = 1
                Label.TextXAlignment = Enum.TextXAlignment.Left

                local Btn = Instance.new("TextButton", ToggFrame)
                Btn.Size = UDim2.new(1, 0, 1, 0)
                Btn.BackgroundTransparency = 1
                Btn.Text = ""

                local toggled = false

                local function setToggle(state)
                    toggled = state
                    local tweeninfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    local tween = TweenService:Create(Box, tweeninfo, {
                        BackgroundColor3 = toggled and Color3.fromRGB(66, 150, 250) or Color3.fromRGB(20,20,20)
                    })
                    tween:Play()
                    local tween2 = TweenService:Create(Check, tweeninfo, {
                        ImageTransparency = toggled and 0 or 1
                    })
                    tween2:Play()
                    if callback then
                        pcall(callback, toggled)
                    end
                end

                Btn.MouseButton1Click:Connect(function()
                    setToggle(not toggled)
                end)

                local ToggleObj = {
                    Frame = ToggFrame,
                    SetValue = setToggle
                }

                return ToggleObj
            end

            function Elements:CreateButton(text, callback)
                local ButtonFrame = Instance.new("Frame", Column)
                ButtonFrame.BackgroundTransparency = 1
                ButtonFrame.Size = UDim2.new(1, 0, 0, 30)

                local Box = Instance.new("Frame", ButtonFrame)
                Box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                Box.Size = UDim2.new(1, 0, 0, 25)
                Box.Position = UDim2.new(0, 0, 0.5, -12.5)
                Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)
                Instance.new("UIStroke", Box).Color = Color3.fromRGB(60, 60, 60)

                local Btn = Instance.new("TextButton", ButtonFrame)
                Btn.Size = UDim2.new(1, 0, 1, 0)
                Btn.BackgroundTransparency = 1
                Btn.Text = ""

                local Label = Instance.new("TextLabel", ButtonFrame)
                Label.Size = UDim2.new(1, 0, 1, 0)
                Label.BackgroundTransparency = 1
                Label.Text = text
                Label.TextSize = 13
                Label.Font = Enum.Font.Gotham
                Label.TextColor3 = Color3.fromRGB(255, 255, 255)

                Btn.MouseButton1Click:Connect(function()
                    if callback then
                        pcall(callback, true)
                    end
                end)

                return ButtonFrame
            end

            function Elements:CreateDropBox(parent, Options, default, callback)
                if not parent or (not parent.Frame and not parent:IsA("GuiObject")) then
                    warn("CreateDropBox: Invalid parent provided")
                    return
                end

                local Box = Instance.new("Frame")
                Box.Parent = parent.Frame or parent
                Box.AnchorPoint = Vector2.new(1, 0)
                Box.Position = UDim2.new(1, -5, 0.5, -9)
                Box.Size = UDim2.new(0, 40, 0, 18)
                Box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)
                Instance.new("UIStroke", Box).Color = Color3.fromRGB(60, 60, 60)

                local Btn = Instance.new("TextButton")
                Btn.Parent = Box
                Btn.AnchorPoint = Vector2.new(0.5, 0.5)
                Btn.Size = UDim2.new(1, -4, 1, -4)
                Btn.Position = UDim2.new(0.5, 0, 0.5, 0)
                Btn.BackgroundTransparency = 1
                Btn.TextSize = 11
                Btn.Font = Enum.Font.Gotham
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)

                local index = table.find(Options, default) or 1
                Btn.Text = tostring(Options[index])

                Btn.MouseButton1Click:Connect(function()
                    index = index + 1
                    if index > #Options then
                        index = 1
                    end
                    Btn.Text = tostring(Options[index])
                    if callback then
                        pcall(callback, Options[index])
                    end
                end)

                return Box
            end

            function Elements:CreateKeybind(toggleObj, default, callback)
                if not toggleObj or not toggleObj.Frame then
                    warn("CreateKeybind: Invalid toggle object provided")
                    return
                end

                local parent = toggleObj.Frame
                local UIS = game:GetService("UserInputService")

                local Box = Instance.new("Frame")
                Box.Parent = parent
                Box.AnchorPoint = Vector2.new(0, 0)
                Box.Position = UDim2.new(0.9, 0,0.5, -9)
                Box.Size = UDim2.new(0, 18, 0, 18)
                Box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)
                Instance.new("UIStroke", Box).Color = Color3.fromRGB(60, 60, 60)

                local Btn = Instance.new("TextButton")
                Btn.Parent = Box
                Btn.AnchorPoint = Vector2.new(0.5, 0.5)
                Btn.Position = UDim2.new(0.5, 0, 0.5, 0)
                Btn.Size = UDim2.new(1, -4, 1, -4)
                Btn.BackgroundTransparency = 1
                Btn.Font = Enum.Font.Gotham
                Btn.TextScaled = true
                Btn.TextColor3 = Color3.fromRGB(255, 255, 255)

                local key
                if typeof(default) == "EnumItem" then
                    key = default.Name
                else
                    key = default or "E"
                end

                Btn.Text = key

                local waitingForKey = false
                local cooldown = false

                Btn.MouseButton1Click:Connect(function()
                    if cooldown then return end
                    cooldown = true
                    waitingForKey = true
                    Btn.Text = "..."
                end)

                UIS.InputBegan:Connect(function(input, processed)
                    if processed then return end
                    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

                    if waitingForKey then
                        waitingForKey = false
                        key = input.KeyCode.Name
                        Btn.Text = key
                        task.delay(0.15, function()
                            cooldown = false
                        end)
                        if callback then
                            pcall(callback, key)
                        end
                    else
                        if input.KeyCode.Name == key then
                            if toggleObj.SetValue then
                                local currentState = parent:FindFirstChild("Frame") 
                                    and parent.Frame.BackgroundColor3 == Color3.fromRGB(66, 150, 250)
                                toggleObj.SetValue(not currentState)
                            end
                        end
                    end
                end)

                return Box
            end

            function Elements:CreateSlider(text, min, max, default, callback)
                local SliderFrame = Instance.new("Frame", Column)
                SliderFrame.Size = UDim2.new(1, 0, 0, 45)
                SliderFrame.BackgroundTransparency = 1

                local Label = Instance.new("TextLabel", SliderFrame)
                Label.Text = text
                Label.TextSize = 13
                Label.Size = UDim2.new(0.7, 0, 0, 20)
                Label.TextColor3 = Color3.fromRGB(255, 255, 255)
                Label.Font = Enum.Font.Gotham
                Label.BackgroundTransparency = 1
                Label.TextXAlignment = Enum.TextXAlignment.Left

                local ValLabel = Instance.new("TextLabel", SliderFrame)
                ValLabel.Text = tostring(default)
                ValLabel.TextSize = 13
                ValLabel.Position = UDim2.new(0.7, 0, 0, 0)
                ValLabel.Size = UDim2.new(0.3, 0, 0, 20)
                ValLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                ValLabel.Font = Enum.Font.GothamMedium
                ValLabel.BackgroundTransparency = 1
                ValLabel.TextXAlignment = Enum.TextXAlignment.Right

                local Sbg = Instance.new("Frame", SliderFrame)
                Sbg.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                Sbg.Position = UDim2.new(0, 0, 0, 28)
                Sbg.Size = UDim2.new(1, 0, 0, 4)
                Instance.new("UICorner", Sbg).CornerRadius = UDim.new(1, 0)

                local Fill = Instance.new("Frame", Sbg)
                Fill.BackgroundColor3 = Color3.fromRGB(66, 150, 250)
                Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
                Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

                local function update()
                    local pos = math.clamp((Mouse.X - Sbg.AbsolutePosition.X) / Sbg.AbsoluteSize.X, 0, 1)
                    Fill.Size = UDim2.new(pos, 0, 1, 0)
                    local val = math.floor(pos * (max - min) + min)
                    ValLabel.Text = tostring(val)
                    if callback then
                        pcall(callback, val)
                    end
                end

                Sbg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        local move
                        move = Mouse.Move:Connect(function()
                            dragging = false
                            update()
                        end)
                        local releaseConnection
                        releaseConnection = UserInputService.InputEnded:Connect(function(input2)
                            if input2.UserInputType == Enum.UserInputType.MouseButton1 then
                                if move then move:Disconnect() end
                                if releaseConnection then releaseConnection:Disconnect() end
                            end
                        end)
                    end
                end)

                return SliderFrame
            end

            return Elements
        end
        return Sections
    end

    Tabs.Unload = function()
        if ModernUI then
            ModernUI:Destroy()
        end
    end

    return Tabs
end

return Library
