            KBtn.Text = default and default.Name or "None"
            KBtn.TextColor3 = Theme.Text
            KBtn.TextSize = 11
            KBtn.Font = Enum.Font.Gotham
            KBtn.Parent = Keybind
            
            local BtnCorner = Instance.new("UICorner")
            BtnCorner.CornerRadius = UDim.new(0, 4)
            BtnCorner.Parent = KBtn
            
            local binding = false
            local currentKey = default
            
            KBtn.MouseButton1Click:Connect(function()
                binding = true
                KBtn.Text = "..."
                Tween(KBtn, {TextColor3 = Theme.Accent})
            end)
            
            UserInputService.InputBegan:Connect(function(input, gpe)
                if binding then
                    if input.KeyCode ~= Enum.KeyCode.Unknown then
                        currentKey = input.KeyCode
                        KBtn.Text = input.KeyCode.Name
                        Tween(KBtn, {TextColor3 = Theme.Text})
                        binding = false
                    end
                elseif not gpe and input.KeyCode == currentKey then
                    pcall(callback)
                end
            end)
        end
        
        -- Color Picker
        function Tab:CreateColorPicker(config)
            config = config or {}
            local name = config.Name or "Color Picker"
            local default = config.Default or Color3.fromRGB(255, 0, 0)
            local callback = config.Callback or function() end
            
            local ColorPicker = Instance.new("Frame")
            ColorPicker.Size = UDim2.new(1, 0, 0, 35)
            ColorPicker.BackgroundColor3 = Theme.Tertiary
            ColorPicker.BorderSizePixel = 0
            ColorPicker.Parent = TabFrame
            
            local CCorner = Instance.new("UICorner")
            CCorner.CornerRadius = UDim.new(0, 6)
            CCorner.Parent = ColorPicker
            
            local CLabel = Instance.new("TextLabel")
            CLabel.Size = UDim2.new(1, -30, 1, 0)
            CLabel.Position = UDim2.new(0, 12, 0, 0)
            CLabel.BackgroundTransparency = 1
            CLabel.Text = name
            CLabel.TextColor3 = Theme.Text
            CLabel.TextSize = 13
            CLabel.Font = Enum.Font.Gotham
            CLabel.TextXAlignment = Enum.TextXAlignment.Left
            CLabel.Parent = ColorPicker
            
            local CBox = Instance.new("TextButton")
            CBox.Size = UDim2.new(0, 16, 0, 16)
            CBox.Position = UDim2.new(1, -26, 0.5, -8)
            CBox.BackgroundColor3 = default
            CBox.BorderSizePixel = 0
            CBox.Text = ""
            CBox.Parent = ColorPicker
            
            local BoxCorner = Instance.new("UICorner")
            BoxCorner.CornerRadius = UDim.new(0, 4)
            BoxCorner.Parent = CBox
            
            -- Color Picker Window
            local PickerWin = Instance.new("Frame")
            PickerWin.Name = "PickerWindow"
            PickerWin.Size = UDim2.new(0, 200, 0, 220)
            PickerWin.Position = UDim2.new(1, 10, 0, -90)
            PickerWin.BackgroundColor3 = Theme.Secondary
            PickerWin.BorderSizePixel = 0
            PickerWin.Visible = false
            PickerWin.ZIndex = 100
            PickerWin.Parent = ColorPicker
            
            local WinCorner = Instance.new("UICorner")
            WinCorner.CornerRadius = UDim.new(0, 8)
            WinCorner.Parent = PickerWin
            
            local Canvas = Instance.new("ImageButton")
            Canvas.Size = UDim2.new(1, -70, 1, -80)
            Canvas.Position = UDim2.new(0, 10, 0, 10)
            Canvas.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            Canvas.BorderSizePixel = 0
            Canvas.Image = "rbxassetid://4155801252"
            Canvas.Parent = PickerWin
            
            local CanvasCorner = Instance.new("UICorner")
            CanvasCorner.CornerRadius = UDim.new(0, 6)
            CanvasCorner.Parent = Canvas
            
            local HueBar = Instance.new("ImageButton")
            HueBar.Size = UDim2.new(0, 25, 1, -80)
            HueBar.Position = UDim2.new(1, -35, 0, 10)
            HueBar.BackgroundColor3 = Color3.white
            HueBar.BorderSizePixel = 0
            HueBar.Image = "rbxassetid://3641079629"
            HueBar.Parent = PickerWin
            
            local HueCorner = Instance.new("UICorner")
            HueCorner.CornerRadius = UDim.new(0, 6)
            HueCorner.Parent = HueBar
            
            local CopyBtn = Instance.new("TextButton")
            CopyBtn.Size = UDim2.new(0.48, -7, 0, 30)
            CopyBtn.Position = UDim2.new(0, 10, 1, -40)
            CopyBtn.BackgroundColor3 = Theme.Background
            CopyBtn.BorderSizePixel = 0
            CopyBtn.Text = "Copy"
            CopyBtn.TextColor3 = Theme.Text
            CopyBtn.TextSize = 11
            CopyBtn.Font = Enum.Font.Gotham
            CopyBtn.Parent = PickerWin
            
            local CopyCorner = Instance.new("UICorner")
            CopyCorner.CornerRadius = UDim.new(0, 4)
            CopyCorner.Parent = CopyBtn
            
            local PasteBtn = Instance.new("TextButton")
            PasteBtn.Size = UDim2.new(0.48, -7, 0, 30)
            PasteBtn.Position = UDim2.new(0.52, 4, 1, -40)
            PasteBtn.BackgroundColor3 = Theme.Background
            PasteBtn.BorderSizePixel = 0
            PasteBtn.Text = "Paste"
            PasteBtn.TextColor3 = Theme.Text
            PasteBtn.TextSize = 11
            PasteBtn.Font = Enum.Font.Gotham
            PasteBtn.Parent = PickerWin
            
            local PasteCorner = Instance.new("UICorner")
            PasteCorner.CornerRadius = UDim.new(0, 4)
            PasteCorner.Parent = PasteBtn
            
            local h, s, v = RGBToHSV(default.R, default.G, default.B)
            local copiedColor = default
            
            local function updateColor(newH, newS, newV)
                h = newH or h
                s = newS or s
                v = newV or v
                local r, g, b = HSVToRGB(h, s, v)
                local color = Color3.new(r, g, b)
                CBox.BackgroundColor3 = color
                Canvas.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                pcall(callback, color)
            end
            
            Canvas.MouseButton1Down:Connect(function()
                local function update()
                    local mouse = game.Players.LocalPlayer:GetMouse()
                    local x = math.clamp((mouse.X - Canvas.AbsolutePosition.X) / Canvas.AbsoluteSize.X, 0, 1)
                    local y = math.clamp((mouse.Y - Canvas.AbsolutePosition.Y) / Canvas.AbsoluteSize.Y, 0, 1)
                    updateColor(nil, x, 1 - y)
                end
                update()
                local con
                con = game:GetService("RunService").RenderStepped:Connect(function()
                    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                        con:Disconnect()
                    else
                        update()
                    end
                end)
            end)
            
            HueBar.MouseButton1Down:Connect(function()
                local function update()
                    local mouse = game.Players.LocalPlayer:GetMouse()
                    local y = math.clamp((mouse.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
                    updateColor(1 - y, nil, nil)
                end
                update()
                local con
                con = game:GetService("RunService").RenderStepped:Connect(function()
                    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                        con:Disconnect()
                    else
                        update()
                    end
                end)
            end)
            
            CopyBtn.MouseButton1Click:Connect(function()
                copiedColor = CBox.BackgroundColor3
            end)
            
            PasteBtn.MouseButton1Click:Connect(function()
                local h2, s2, v2 = RGBToHSV(copiedColor.R, copiedColor.G, copiedColor.B)
                updateColor(h2, s2, v2)
            end)
            
            CBox.MouseButton1Click:Connect(function()
                PickerWin.Visible = not PickerWin.Visible
            end)
        end
        
        return Tab
    end
    
    return Window
end

return Library
